RELAYFORGE_ENVIRONMENT=development
RELAYFORGE_DATABASE_URL=postgresql+asyncpg://relayforge:relayforge@localhost:5432/relayforge
RELAYFORGE_REDIS_URL=redis://localhost:6379/0
RELAYFORGE_JWT_SECRET=replace-with-at-least-32-random-bytes
RELAYFORGE_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
RELAYFORGE_ACCESS_TOKEN_TTL_SECONDS=900
RELAYFORGE_REFRESH_TOKEN_TTL_SECONDS=2592000
RELAYFORGE_LOG_LEVEL=INFO
RELAYFORGE_ALLOWED_HTTP_HOSTS=
RELAYFORGE_BLOCK_PRIVATE_NETWORKS=true
